<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- TD-12: built-in .NET analyzers at the broadest rule set, no StyleCop -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <!-- Tag-driven versioning: `git tag v1.2.3` produces package version 1.2.3.
       Untagged builds get a height-suffixed prerelease off the last tag. -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- Public API surface tracking, on the publishable libraries only. Every public member
       must be listed in PublicAPI.Shipped.txt or PublicAPI.Unshipped.txt; RS0016 (member
       missing from the files) and RS0017 (member listed but gone) are errors under the
       repo-wide TreatWarningsAsErrors. In a single solution an accidental `public` is
       harmless — here it is a permanent compatibility obligation to a package consumer,
       and this turns the major-vs-minor release decision into a reviewable text diff. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Package metadata shared by every publishable platform library.
       Per-project PackageId/Description live in the individual csproj files.
       No licence is declared: these are private packages on an authenticated feed. -->
  <PropertyGroup>
    <Authors>Mark Chivers</Authors>
    <Company>Mark Chivers</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/markchivs73/frontier-platform</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Symbols are embedded rather than shipped as .snupkg: GitHub Packages does not
         accept symbol packages, so a separate snupkg would fail the push. -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Required alongside the two properties above: without it the embedded sources carry
         absolute build-machine paths, so SourceLink cannot resolve them from a published
         package. Set only on the CI runner so local builds keep debuggable local paths. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageProjectUrl>https://github.com/markchivs73/frontier-platform</PackageProjectUrl>
    <PackageTags>frontier;platform;workflow-orchestration</PackageTags>
  </PropertyGroup>

  <!-- Package README, picked up only where one exists. The condition is load-bearing: an
       unconditional PackageReadmeFile pointing at a missing file is a hard NU5039 error, not
       a warning, so this lets the nine "missing a readme" pack warnings clear one library at
       a time as READMEs are written. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
