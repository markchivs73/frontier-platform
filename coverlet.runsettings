<?xml version="1.0" encoding="utf-8" ?>
<!--
  Vendored from frontier-workflow/coverlet.runsettings @ 8df00ee.
  Drift check: git -C ../frontier-workflow log 8df00ee..HEAD coverlet.runsettings
  (an XML comment cannot contain a double hyphen, so no short-form git flags here)

  Coverlet XPlat (dotnet test, collect XPlat Code Coverage, settings coverlet.runsettings)
  measures src library code only; test assemblies (and the SDK's auto-generated test-host
  Program.cs) are excluded since they're the harness, not the code under test. The trailing
  wildcard on "Tests*" also covers the " 2"/" 3"-suffixed duplicate modules that appear when
  a test loads its own assembly into a second AssemblyLoadContext.

  The [*ArchitectureTests]* and [*.Fixtures.*]* patterns are additions over the source file:
  "Frontier.Platform.ArchitectureTests" contains no ".Tests" substring, so [*.Tests*]* does
  not match it. Without these the runsettings and coverage_by_assembly.py disagree — the
  script's own name.endswith("Tests") filter was the only thing excluding it.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Exclude>[*.Tests*]*,[*ArchitectureTests]*,[*.Fixtures.*]*</Exclude>
          <ExcludeByAttribute>System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
