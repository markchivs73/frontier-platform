<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Resolves the Frontier.Platform.* packages from the local ./artifacts folder produced by
    `dotnet pack`, and everything else (Cosmos, Polly, Microsoft.Extensions.*) from nuget.org.

    This is what makes the smoke consumer meaningful: it restores the real .nupkg files
    rather than project references, so a dependency missing from a nuspec, or a type that is
    internal but needed, fails here instead of in a consumer's repository.
  -->
  <packageSources>
    <clear />
    <add key="local-artifacts" value="../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
