<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Frontier.Platform.SmokeConsumer</RootNamespace>
    <!-- NuGet does not copy a package's XML documentation to the output directory by default;
         it leaves it in the package folder for the IDE. Frontier.Platform.Workflow.Model's
         docs are read at *runtime* (the design-language schema generator turns them into field
         descriptions), so a consumer that reads them must opt in. Verified by this sample:
         without it, the doc file is absent and the failure is silent — descriptions simply
         become empty. -->
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
  </PropertyGroup>

  <!--
    Floating "*-*" resolves the highest version available including prereleases, which is
    whatever `dotnet pack` just wrote into ../artifacts. MinVer stamps a prerelease version
    on untagged builds, so a fixed version here would need updating on every run.
  -->
  <ItemGroup>
    <PackageReference Include="Frontier.Platform.Abstractions" Version="*-*" />
    <PackageReference Include="Frontier.Platform.Audit" Version="*-*" />
    <PackageReference Include="Frontier.Platform.ContextAssembly" Version="*-*" />
    <PackageReference Include="Frontier.Platform.Guardrails" Version="*-*" />
    <PackageReference Include="Frontier.Platform.Hitl" Version="*-*" />
    <PackageReference Include="Frontier.Platform.ModelRoleConfig" Version="*-*" />
    <PackageReference Include="Frontier.Platform.Observability" Version="*-*" />
    <PackageReference Include="Frontier.Platform.Resilience" Version="*-*" />
    <PackageReference Include="Frontier.Platform.Serialization" Version="*-*" />
    <PackageReference Include="Frontier.Platform.Workflow.Model" Version="*-*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
  </ItemGroup>

</Project>
